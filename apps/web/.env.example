# Public URL of this app. OAuth callbacks are derived from it.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/open_software_factory
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
# GitHub OAuth app with callback URL $APP_URL/api/auth/callback/github
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
